{
    "name": "tobycroft/think-captcha",
    "description": "thinkphp8+ captcha 2026 version PHP8.5+",
    "authors": [
        {
            "name": "tobycroft",
            "email": "silverhawk@foxmail.com"
        }
    ],
    "license": "MIT",
    "require": {
        "topthink/framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "tobycroft\\captcha\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "extra": {
        "think": {
            "services": [
                "tobycroft\\captcha\\CaptchaService"
            ],
            "config":{
                "captcha": "src/config.php"
            }
        }
    }
}